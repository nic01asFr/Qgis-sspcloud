{# Partial _interactive_map — pre-rendu inline MapLibre pour storymap

   Vague A Commit 2 (D-QGIS-008). MapLibre standalone + scene_manifest layers.
   Vague E2 Commit 4 (D-QGIS-009 §4) : trio cartographe metier obligatoire
   (Titre + Légende auto + Source datée + Caveat) rendu sous chaque carte.
   Convention metier CEREMA : une carte sans ce trio est inexploitable
   en COPIL (lecteur ne sait pas QUOI il lit, D'OÙ ça vient, JUSQU'OÙ
   il peut extrapoler).

   Le template parent (storymap_dsfr.html.j2) doit charger MapLibre CSS+JS
   dans son <head> (CDN unpkg).

   Variables :
   - cid : str (composant id 12 hex, pour div map_<8hex>)
   - title : str (titre composant)
   - bbox_text : str (ex. ' — 1 couche · 14270 objets')
   - center_lng, center_lat : float (default Marseille 4e 5.39, 43.30)
   - zoom : float (default 13)
   - map_layers_json : str (JSON ready to inline, layers avec geojson)
   - source_text : str optionnel (source datee auto-filled depuis catalog)
   - caveat : str optionnel (caveat methodologique)
   - legend_items : list optionnel (autoderived from layers + palette)
#}
{% set map_id = 'map_' + cid[:8] %}
<div style="background:#fff;border-radius:6px;overflow:hidden;
            border:1px solid #e5e5e5">
  {# A — TITRE OBLIGATOIRE + sous-titre + description (v1.12 cle metier CEREMA) #}
  <div style="padding:14px 20px;border-bottom:1px solid #e5e5e5;background:#f6f6f6">
    <strong style="color:#000091;font-size:15px;display:block">{{ title | e }}</strong>
    {% if subtitle %}
    <div style="color:#444;font-size:13px;margin-top:2px">{{ subtitle | e }}</div>
    {% endif %}
    <span style="color:#666;font-size:12px;font-style:italic">{{ bbox_text | e }}</span>
  </div>
  {% if description %}
  <div style="padding:10px 20px;background:#fafbfd;border-bottom:1px solid #e5e5e5;
              font-size:13px;color:#333;line-height:1.5">
    {{ description | e }}
  </div>
  {% endif %}
  {# Canvas MapLibre (hauteur configurable v1.12) #}
  <div id="{{ map_id }}" style="height:{{ height | default(480) }}px;width:100%"></div>
  {# B — LEGENDE AUTO-DERIVEE riche (Vague E2 Commit 10)
     3 formats supportes selon legend_format :
     - 'chips' (default, V0.1) : puces couleur + label, layout flex inline
     - 'gradient_bar' : barre gradient continue avec breakpoints labelles
                       (pour classification.type=graduated)
     - 'proportional' : 3 cercles taille croissante avec labels
                       (pour layer.proportional_field) #}
  {% if legend_items %}
  <div style="padding:12px 20px;background:#fafafa;border-top:1px solid #e5e5e5;
              font-size:12px;color:#444">
    <strong style="color:#000091;text-transform:uppercase;font-size:11px;
                   letter-spacing:.5px;display:block;margin-bottom:8px">Légende</strong>
    {% set fmt = legend_format | default('chips') %}
    {% if fmt == 'gradient_bar' %}
      {# Barre gradient continue : couleurs en row, labels en row dessous #}
      {% set total = legend_items | length %}
      <div style="display:flex;height:14px;border-radius:3px;overflow:hidden;
                  border:1px solid rgba(0,0,0,.1);max-width:520px">
        {% for item in legend_items %}
        <div style="flex:1;background:{{ item.color | e }}"></div>
        {% endfor %}
      </div>
      <div style="display:flex;font-size:10px;color:#666;margin-top:4px;
                  max-width:520px">
        {% for item in legend_items %}
        <div style="flex:1;text-align:center;padding:0 2px">{{ item.label | e }}</div>
        {% endfor %}
      </div>
    {% elif fmt == 'proportional' %}
      {# 3 cercles tailles croissantes avec labels #}
      <div style="display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap">
        {% for item in legend_items %}
        <div style="display:flex;flex-direction:column;align-items:center;gap:2px">
          <div style="width:{{ item.size | default(20) }}px;
                      height:{{ item.size | default(20) }}px;
                      background:{{ item.color | e }};border-radius:50%;
                      border:1px solid #fff;
                      box-shadow:0 0 0 1px rgba(0,0,0,.2);
                      opacity:.75"></div>
          <span style="font-size:10px;color:#666">{{ item.label | e }}</span>
        </div>
        {% endfor %}
      </div>
    {% else %}
      {# Default chips (V0.1) #}
      <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center">
      {% for item in legend_items %}
      <span style="display:inline-flex;align-items:center;gap:6px">
        <span style="display:inline-block;width:14px;height:14px;
                     background:{{ item.color | e }};border-radius:3px;
                     border:1px solid rgba(0,0,0,.1)"></span>
        <span>{{ item.label | e }}{% if item.count %} <em style="color:#888">({{ item.count }})</em>{% endif %}</span>
      </span>
      {% endfor %}
      </div>
    {% endif %}
  </div>
  {% endif %}
  {# C — SOURCE DATEE (trio cartographe metier) #}
  {% if source_text %}
  <div style="padding:8px 20px;background:#fafafa;border-top:1px solid #f0f0f0;
              font-size:11px;color:#666;font-style:italic">
    Source : {{ source_text | e }}
  </div>
  {% endif %}
  {# D — CAVEAT METHODOLOGIQUE (lecture critique) #}
  {% if caveat %}
  <div style="padding:8px 20px;background:#fff8e6;border-top:1px solid #ffe1a8;
              font-size:11px;color:#7a4b00">
    <strong style="color:#b34000">⚠ Caveat :</strong> {{ caveat | e }}
  </div>
  {% endif %}
  {# Si AUCUN element du trio (legend, source, caveat) : afficher hint
     anti-pattern pour aider l'utilisateur a completer #}
  {% if not source_text and not caveat and not legend_items %}
  <div style="padding:8px 20px;background:#fff8e6;border-top:1px solid #ffe1a8;
              font-size:11px;color:#7a4b00;font-style:italic">
    ℹ Carte sans légende/source/caveat — ajouter ces métadonnées pour usage COPIL.
  </div>
  {% endif %}
</div>
{# Sprint sec-vague0 dette OOM PMTiles V0.4 (2026-07-21) : charge le
   plugin pmtiles-protocol depuis unpkg (autorise par CSP hub). Une seule
   fois par page (idempotent guard sur window.pmtiles). Vector tiles
   servis via HTTP Range Requests par serve_published (Commit 5). #}
<script>
if (typeof window !== 'undefined' && typeof pmtiles === 'undefined') {
  document.write('<script src="https://unpkg.com/pmtiles@3.0.6/dist/index.js"><\/script>');
}
</script>
<script>
(function() {
  if (typeof maplibregl === 'undefined') {
    document.getElementById('{{ map_id }}').innerHTML =
      '<div style="padding:40px;text-align:center;color:#666">MapLibre indisponible.</div>';
    return;
  }
  // Sprint sec-vague0 dette OOM PMTiles V0.4 (2026-07-21) : enregistre
  // le protocol 'pmtiles://' pour permettre a MapLibre de lire les vector
  // tiles PMTiles via HTTP Range Requests. Le script pmtiles-protocol
  // est charge en tete du partial (CDN unpkg autorise par CSP hub).
  // Fail-safe : si pmtiles pas dispo (CDN down), les layers PMTiles
  // affichent une erreur non-bloquante mais les layers geojson
  // continuent de fonctionner.
  if (typeof pmtiles !== 'undefined' && !window.__pmtilesProtocolRegistered) {
    try {
      const protocol = new pmtiles.Protocol();
      maplibregl.addProtocol('pmtiles', protocol.tile);
      window.__pmtilesProtocolRegistered = true;
    } catch (e) {
      console.warn('pmtiles protocol registration failed:', e);
    }
  }
  const layers = {{ map_layers_json | safe }};
  {# Vague E2 Commit 7 : catalogue fonds via basemap_style_json injecte par hub.
     Fallback OSM si absent. #}
  const basemapStyle = {{ basemap_style_json | safe if basemap_style_json else '{version:8,sources:{osm:{type:"raster",tiles:["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],tileSize:256}},layers:[{id:"osm",type:"raster",source:"osm"}]}' }};
  const map = new maplibregl.Map({
    container: '{{ map_id }}',
    style: basemapStyle,
    center: [{{ center_lng | float }}, {{ center_lat | float }}],
    zoom: {{ zoom | float }}
  });
  map.addControl(new maplibregl.NavigationControl(), 'top-left');
  // Sprint V0.4.3 P0.4 : attribution obligatoire (licences fonds + donnees)
  // pour livrable public conforme (OSM licence ODbL, IGN Etalab-2.0, etc.).
  map.addControl(new maplibregl.AttributionControl({compact: true}), 'bottom-right');
  // Vague E2 Commit 6 (D-QGIS-009 §6) : interactions
  // - hover_attributes : attributs a afficher dans tooltip survol
  // - popup_template : template HTML au clic (placeholders {prop})
  const popup = new maplibregl.Popup({closeButton: true, maxWidth: '320px'});
  const tooltip = new maplibregl.Popup({closeButton: false, closeOnClick: false, maxWidth: '240px'});
  const layerToggleControl = {};
  map.on('load', () => {
    const palette = ['#000091','#e1000f','#1f8d4d','#ff6f00','#9c27b0','#0288d1'];
    layers.forEach((layer, i) => {
      // Sprint sec-vague0 dette OOM PMTiles V0.4 (2026-07-21) : 3 modes
      // possibles selon comment le hub a externalise le layer :
      // 1. layer.source_type === 'pmtiles' + layer.tiles_url : vector
      //    tiles PMTiles (Commit 3 cascade niveau 1). Le layer.geojson
      //    a ete supprime pour alleger le HTML.
      // 2. layer.geojson (str URL) : URL geojson S3 gzip (Commit 3
      //    cascade niveau 2, fallback si PMTiles echoue).
      // 3. layer.geojson (dict) : inline historique (Commit 3 cascade
      //    niveau 3, dernier recours).
      const isPmtiles = layer.source_type === 'pmtiles' && layer.tiles_url;
      if (!isPmtiles && !layer.geojson) return;
      const sourceId = 'src-' + layer.id;
      const layerId = 'lyr-' + layer.id;
      // Pour PMTiles : nom du source-layer dans les tuiles MVT (defini
      // au moment de l'encoding cote hub, cf. pmtiles_encoder.py).
      // Pour geojson : indefini, MapLibre lit directement `source`.
      const srcLayerName = isPmtiles
        ? (layer.source_layer_name || 'features')
        : undefined;
      try {
        if (isPmtiles) {
          // Vector tiles via PMTiles Protocol. MapLibre fetch les tuiles
          // via HTTP Range Requests declenches par le protocol handler
          // registre en tete de partial. Cache HTTP navigateur applique
          // (Cache-Control: immutable cote serve_published Commit 5).
          map.addSource(sourceId, {
            type: 'vector',
            url: 'pmtiles://' + layer.tiles_url,
          });
        } else {
          // GeoJSON inline (dict) ou URL string : MapLibre native
          // accepte les 2 dans le champ `data`.
          map.addSource(sourceId, {type:'geojson', data:layer.geojson});
        }
        const isPoint = (layer.geometry_type || '').toLowerCase().includes('point');
        const isLine  = (layer.geometry_type || '').toLowerCase().includes('line');
        // Vague E2 Commit 5 : applique paint_expression de classification thematique
        // si layer.classification existe (graduated/categorized), sinon flat color
        // depuis palette index.
        const classif = layer.classification || {};
        const themedColor = classif.paint_expression ||
                            palette[i % palette.length];
        // Vague E2 Commit 8 : proportional symbols + heatmap
        // - layer.proportional_field : si defini, circle-radius = f(value)
        // - layer.heatmap_field : si defini, render heatmap layer au lieu de circles
        // PMTiles V0.4 : pour les layer sur vector tiles, MapLibre exige
        // un champ `source-layer` (nom MVT interne). Pour geojson il ne
        // doit PAS etre present. On spread dans chaque addLayer.
        const srcLayerSpread = isPmtiles ? {'source-layer': srcLayerName} : {};
        if (layer.heatmap_field && isPoint) {
          // Heatmap layer MapLibre (intensite via attribut)
          map.addLayer({id:layerId, type:'heatmap', source:sourceId,
            ...srcLayerSpread,
            maxzoom: 18,
            paint: {
              'heatmap-weight': ['interpolate', ['linear'],
                ['coalesce', ['to-number', ['get', layer.heatmap_field], 0], 0],
                0, 0, 100, 1],
              'heatmap-intensity': ['interpolate', ['linear'], ['zoom'], 0, 1, 18, 3],
              'heatmap-color': ['interpolate', ['linear'], ['heatmap-density'],
                0, 'rgba(0,0,145,0)',
                0.2, 'rgba(0,99,203,0.4)',
                0.4, 'rgba(255,225,0,0.6)',
                0.6, 'rgba(255,103,0,0.8)',
                1, 'rgba(225,0,15,1)'],
              'heatmap-radius': ['interpolate', ['linear'], ['zoom'], 0, 2, 18, 30],
              'heatmap-opacity': ['interpolate', ['linear'], ['zoom'], 14, 1, 18, 0.5],
            }
          });
        } else if (isPoint && layer.proportional_field) {
          // Symboles proportionnels : circle-radius = f(value)
          const propField = layer.proportional_field;
          const propMin = (layer.proportional_min !== undefined) ? layer.proportional_min : 0;
          const propMax = (layer.proportional_max !== undefined) ? layer.proportional_max : 1000;
          const radiusMin = (layer.proportional_radius_min !== undefined) ? layer.proportional_radius_min : 4;
          const radiusMax = (layer.proportional_radius_max !== undefined) ? layer.proportional_radius_max : 30;
          map.addLayer({id:layerId, type:'circle', source:sourceId,
            ...srcLayerSpread,
            paint:{
              'circle-color': themedColor,
              'circle-radius': ['interpolate', ['linear'],
                ['coalesce', ['to-number', ['get', propField], 0], 0],
                propMin, radiusMin,
                propMax, radiusMax],
              'circle-stroke-width':1, 'circle-stroke-color':'#fff',
              'circle-opacity': 0.75,
            }});
        } else if (isPoint) {
          map.addLayer({id:layerId, type:'circle', source:sourceId,
            ...srcLayerSpread,
            paint:{'circle-color': themedColor, 'circle-radius':6,
                  'circle-stroke-width':1, 'circle-stroke-color':'#fff'}});
        } else if (isLine) {
          map.addLayer({id:layerId, type:'line', source:sourceId,
            ...srcLayerSpread,
            paint:{'line-color': themedColor, 'line-width':2}});
        } else {
          map.addLayer({id:layerId, type:'fill', source:sourceId,
            ...srcLayerSpread,
            paint:{'fill-color': themedColor, 'fill-opacity':0.6,
                  'fill-outline-color': '#ffffff'}});
        }
        layerToggleControl[layerId] = {name: layer.name || layer.id, color: typeof themedColor === 'string' ? themedColor : palette[i % palette.length], visible: true};
        // ── Interactions Vague E2 Commit 6 ──
        // Tooltip survol : si layer.hover_attributes liste les attributs cles
        const hoverAttrs = layer.hover_attributes || [];
        if (hoverAttrs.length) {
          map.on('mousemove', layerId, (e) => {
            map.getCanvas().style.cursor = 'pointer';
            const props = (e.features[0] && e.features[0].properties) || {};
            const rows = hoverAttrs.filter(a => props[a] !== undefined)
              .map(a => '<div style="padding:2px 0"><strong>'+a+'</strong> : '+String(props[a]).slice(0,80)+'</div>')
              .join('');
            if (rows) {
              tooltip.setLngLat(e.lngLat).setHTML('<div style="font-size:12px">'+rows+'</div>').addTo(map);
            }
          });
          map.on('mouseleave', layerId, () => {
            map.getCanvas().style.cursor = '';
            tooltip.remove();
          });
        }
        // Popup au clic : si layer.popup_template defini OU fallback liste props
        const popupTpl = layer.popup_template;
        map.on('click', layerId, (e) => {
          const props = (e.features[0] && e.features[0].properties) || {};
          let html;
          if (popupTpl) {
            // Template avec placeholders {prop}
            html = popupTpl.replace(/\{(\w+)\}/g, (m, k) => {
              const v = props[k];
              return v === undefined ? '' : String(v);
            });
          } else {
            // Fallback : liste tous props (top 10)
            const entries = Object.entries(props).slice(0, 10);
            html = '<div style="font-size:13px"><strong style="color:#000091">'
              + (layer.name || 'Feature') + '</strong>'
              + entries.map(([k, v]) =>
                  '<div style="padding:3px 0;border-top:1px solid #eee;margin-top:3px">'
                  + '<span style="color:#666;font-size:11px">'+k+'</span><br>'
                  + '<strong>'+String(v).slice(0,120)+'</strong></div>'
                ).join('')
              + '</div>';
          }
          popup.setLngLat(e.lngLat).setHTML(html).addTo(map);
        });
      } catch (e) { console.warn('addLayer failed', layer.id, e); }
    });
    // Layer toggle UI panel (Vague E2 Commit 6)
    if (Object.keys(layerToggleControl).length > 1) {
      const toggleDiv = document.createElement('div');
      toggleDiv.style.cssText = 'position:absolute;top:10px;right:10px;background:rgba(255,255,255,0.95);padding:10px 12px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.15);font-size:12px;max-width:180px;z-index:1';
      toggleDiv.innerHTML = '<div style="font-weight:700;color:#000091;margin-bottom:6px;font-size:11px;text-transform:uppercase">Couches</div>';
      Object.keys(layerToggleControl).forEach(lid => {
        const item = layerToggleControl[lid];
        const row = document.createElement('label');
        row.style.cssText = 'display:flex;align-items:center;gap:6px;padding:3px 0;cursor:pointer';
        row.innerHTML = '<input type="checkbox" checked style="margin:0"><span style="width:12px;height:12px;background:'+item.color+';border-radius:2px;display:inline-block"></span><span>'+item.name+'</span>';
        row.querySelector('input').addEventListener('change', (e) => {
          const visible = e.target.checked ? 'visible' : 'none';
          try { map.setLayoutProperty(lid, 'visibility', visible); } catch(e) {}
        });
        toggleDiv.appendChild(row);
      });
      document.getElementById('{{ map_id }}').appendChild(toggleDiv);
    }
    // fitBounds() : Sprint sec-vague0 dette OOM PMTiles V0.4 (2026-07-21)
    // priorite 1 = layer.bbox (calcule au hub cote encoder PMTiles,
    // disponible pour source_type='pmtiles') ; priorite 2 = walk sur
    // features geojson dict inline. Pour source geojson URL string,
    // les features ne sont pas dispo cote SSR -> pas de fitBounds, on
    // reste sur center/zoom du hub.
    if (layers.length && layers[0]) {
      try {
        const l0 = layers[0];
        if (l0.bbox && l0.bbox.length === 4) {
          const [minLng, minLat, maxLng, maxLat] = l0.bbox;
          const b = new maplibregl.LngLatBounds([minLng, minLat], [maxLng, maxLat]);
          if (!b.isEmpty()) map.fitBounds(b, {padding:40, maxZoom:16});
        } else if (l0.geojson && typeof l0.geojson === 'object' && l0.geojson.features) {
          const fs = l0.geojson.features || [];
          if (fs.length) {
            const b = new maplibregl.LngLatBounds();
            fs.forEach(f => {
              const coords = (f.geometry && f.geometry.coordinates) || [];
              const walk = (c) => {
                if (typeof c[0] === 'number') { b.extend(c); return; }
                c.forEach(walk);
              };
              walk(coords);
            });
            if (!b.isEmpty()) map.fitBounds(b, {padding:40, maxZoom:16});
          }
        }
      } catch (e) { console.warn('fitBounds failed', e); }
    }
  });
})();
</script>

{# Composant narrative_text — Paragraphes narratifs Markdown via Marked.js.

   Sprint Composants Phase 2 (2026-06-25).

   Variables Jinja2 attendues :
   - component : dict Component
   - markdown_content : string Markdown brut (component.params.markdown)
                       OU contenu inline depuis user editor

   Pattern : Marked.js 11.x via CDN. DOMPurify pour XSS-safe rendering
   (markdown peut contenir HTML inline, on sanitize).
#}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{ component.title|e }}</title>
<script src="https://cdn.jsdelivr.net/npm/marked@11.1.1/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.8/dist/purify.min.js"></script>
<style>
body{margin:0;padding:20px 24px;font-family:Marianne,Georgia,serif;
  background:#fff;color:#161616;line-height:1.65;font-size:14px;
  max-width:680px}
h1,h2,h3,h4{font-family:Marianne,system-ui,sans-serif;
  color:#000091;line-height:1.3;margin:1.4em 0 .6em}
h1{font-size:24px}h2{font-size:19px}h3{font-size:16px}h4{font-size:14px}
p{margin:0 0 .9em}
a{color:#0063cb;text-decoration:underline}a:hover{color:#000091}
ul,ol{margin:0 0 .9em;padding-left:1.4em}
li{margin:.2em 0}
blockquote{border-left:3px solid #000091;padding:6px 14px;background:#f6f6f6;
  margin:0 0 .9em;color:#444;font-style:italic}
code{background:#f1f3f5;padding:1px 5px;border-radius:3px;
  font-family:'JetBrains Mono',monospace;font-size:12.5px;color:#b34000}
pre{background:#1d1d35;color:#f6f6f6;padding:12px;border-radius:4px;
  overflow-x:auto;font-size:12.5px}
pre code{background:transparent;color:inherit;padding:0}
hr{border:0;border-top:1px solid #e5e5e5;margin:1.4em 0}
table{border-collapse:collapse;margin:0 0 .9em;width:100%}
th,td{padding:6px 8px;border:1px solid #ddd;text-align:left;font-size:13px}
th{background:#f6f6f6;font-weight:700}
img{max-width:100%;height:auto;border-radius:4px}
.narrative-title{font-size:11px;text-transform:uppercase;letter-spacing:.5px;
  color:#999;margin:0 0 8px;font-family:Marianne,system-ui,sans-serif}
</style>
</head>
<body>
<p class="narrative-title">{{ component.title|e }}</p>
<div id="content"></div>
<script>
const md = {{ markdown_content|tojson }};
marked.setOptions({ gfm: true, breaks: true });
const rawHtml = marked.parse(md);
document.getElementById('content').innerHTML = DOMPurify.sanitize(rawHtml);
</script>
</body>
</html>

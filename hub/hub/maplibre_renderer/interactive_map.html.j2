{# Composant interactive_map — MapLibre GL JS standalone.

   Sprint Composants Phase 2 (2026-06-25).

   Variables Jinja2 attendues :
   - component : dict Component (id, title, source, params, rendering)
   - maplibre_layers : list of MapLibre layer dicts (généré par
                       maplibre_style_mapper.manifest_to_maplibre_layers)
   - data_inline : GeoJSON FeatureCollection (optional, sinon fetch data_url)
   - basemap_url : tile URL pattern (default IGN ORTHOPHOTOS)

   Pattern : MapLibre GL 5.6.1 via CDN unpkg. Mapping kind→style spec
   appliqué côté serveur (Jinja2) plutôt que client (geoai-kit) pour
   réduire la latence affichage initial. geoai-kit Lead #6 fournira
   `applyManifestToMap()` côté client pour les cas dynamiques (Sprint 2+).

   IGN MNT terrain (3D pitch) : pattern addProtocol("ignmnt") cf.
   atlas-territorial-briques/relief3d.html — pas activé V0.1 (placeholder).
#}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{ component.title|e }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

{# MapLibre GL JS 5.6.1 - runtime cartographique majoritaire ecosysteme #}
<link href="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.css" rel="stylesheet"/>
<script src="https://unpkg.com/maplibre-gl@5.6.1/dist/maplibre-gl.js"></script>

<style>
body{margin:0;padding:0;font-family:Marianne,system-ui,sans-serif;
  background:#f6f6f6;color:#161616}
.comp-header{padding:12px 16px;background:#fff;border-bottom:1px solid #e5e5e5}
.comp-title{font-size:14px;font-weight:700;margin:0;color:#000091}
.comp-desc{font-size:11.5px;color:#666;margin:2px 0 0;line-height:1.4}
#map{position:absolute;top:53px;bottom:0;left:0;right:0}
.maplibregl-ctrl-attrib-inner{font-size:10px}
</style>
</head>
<body>
<header class="comp-header">
  <h1 class="comp-title">🗺 {{ component.title|e }}</h1>
  {% if component.description %}
  <p class="comp-desc">{{ component.description|e }}</p>
  {% endif %}
</header>

<div id="map"></div>

<script>
// ── Bootstrap MapLibre ──────────────────────────────────────────────
const basemap = {{ (basemap_url or 'https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=ORTHOIMAGERY.ORTHOPHOTOS&STYLE=normal&FORMAT=image/jpeg&TILEMATRIXSET=PM&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}')|tojson }};

const initialBbox = {{ (component.params.bbox or [-5, 41, 10, 52])|tojson }};
// MapLibre `fitBounds` attend [[west, south], [east, north]]
const bounds = [[initialBbox[0], initialBbox[1]], [initialBbox[2], initialBbox[3]]];

const map = new maplibregl.Map({
  container: 'map',
  style: {
    version: 8,
    sources: {
      'basemap': {type: 'raster', tiles: [basemap], tileSize: 256,
        attribution: '© IGN/Géoplateforme'}
    },
    layers: [
      {id: 'bg', type: 'background', paint: {'background-color': '#e5e5e5'}},
      {id: 'basemap-layer', type: 'raster', source: 'basemap'},
    ]
  },
  bounds: bounds,
  fitBoundsOptions: {padding: 20},
  pitch: {{ (component.params.pitch or 0)|int }},
  bearing: {{ (component.params.bearing or 0)|int }},
  maxPitch: 80,
  attributionControl: true,
});
map.addControl(new maplibregl.NavigationControl({visualizePitch: true}), 'top-right');

// ── Layers Scene Manifest pré-générés côté serveur ──────────────────
const sceneLayers = {{ maplibre_layers|tojson }};
const dataInline = {{ (data_inline or {'type':'FeatureCollection','features':[]})|tojson }};
const dataUrl = {{ (data_url or '')|tojson }};

map.on('load', async () => {
  // Source GeoJSON (inline ou fetch URL)
  let geojson = dataInline;
  if (dataUrl && (!geojson.features || geojson.features.length === 0)) {
    try {
      const resp = await fetch(dataUrl, {credentials: 'include'});
      geojson = await resp.json();
    } catch (e) {
      console.warn('fetch data_url failed', e);
    }
  }

  // Une source par layer (compatible Scene Manifest multi-layers)
  for (const lyr of sceneLayers) {
    if (lyr._unsupported) {
      console.warn('Layer unsupported (kind=3d_model requires Three.js custom layer):', lyr.id);
      continue;
    }
    const srcId = lyr.source;
    if (!map.getSource(srcId)) {
      map.addSource(srcId, {type: 'geojson', data: geojson});
    }
    map.addLayer(lyr);
  }
});

// Expose to parent (iframe embed audit trail)
window.addEventListener('message', (ev) => {
  if (ev.data?.type === 'queryComponent') {
    ev.source.postMessage({
      type: 'componentInfo',
      id: {{ component.id|tojson }},
      kind: 'interactive_map',
      layers: sceneLayers.map(l => l.id),
    }, ev.origin);
  }
});
</script>
</body>
</html>

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 : build BlockNote editor bundle (Vague E2 Commit E1, D-QGIS-010)
# Vite + React + BlockNote v0.22 -> /build/dist (vite outDir = 'dist' relatif).
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS blocknote-builder

WORKDIR /build

# npm install (pas npm ci : package-lock.json non versionne pour l'instant,
# car genere uniquement au premier npm install local. Acceptable V1.
# Pour V1.1+ : commit package-lock.json + reverter en npm ci pour reproducibilite).
COPY blocknote-editor/package.json ./
RUN npm install --no-audit --no-fund --legacy-peer-deps

# Copy source TypeScript + Vite config + index.html
COPY blocknote-editor/ ./

# Build production. vite.config.ts has outDir='dist' -> sortie dans /build/dist.
# Note : on skip tsc -b en CI pour eviter erreurs strict mode sur code brut V1.
RUN npx vite build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 : hub Python (existant)
# ─────────────────────────────────────────────────────────────────────────────
FROM inseefrlab/onyxia-jupyter-python:py3.13.13

USER root
WORKDIR /opt/qgis-hub

COPY hub/ .
RUN pip install -e . --quiet --no-cache-dir

# Templates HTML pour /desk et /workspace
COPY hub/templates/ templates/

# BlockNote editor bundle (Vague E2 D-QGIS-010) : copy depuis le stage builder
COPY --from=blocknote-builder /build/dist /opt/qgis-hub/hub/static/blocknote-editor/

# Le commit d'ou vient cette image. Passe par la CI (`build-args: GIT_SHA=...`)
# et rendu par `/version`. Vide si l'image a ete construite a la main sans cet
# argument : l'endpoint le dit alors explicitement plutot que de laisser croire
# a un commit inconnu.
ARG GIT_SHA=""

ENV SERVICE_NAME=qgis-mcp \
    SERVER_MODULE=hub.main:app \
    SERVER_PORT=8888 \
    HUB_INTERNAL_PORT=8888 \
    HUB_GIT_SHA=${GIT_SHA}

# Remplacer onyxia-init.sh pour respecter SERVER_MODULE (le chart passe toujours
# "jupyter lab" en args mais on veut démarrer le hub uvicorn à la place).
RUN printf '#!/bin/bash\nif [ -n "$SERVER_MODULE" ]; then\n  exec /opt/python/bin/uvicorn "$SERVER_MODULE" --host 0.0.0.0 --port "${HUB_INTERNAL_PORT:-8888}" --log-level info\nfi\nexec "$@"\n' \
    > /opt/onyxia-init.sh && chmod +x /opt/onyxia-init.sh

USER 1000
